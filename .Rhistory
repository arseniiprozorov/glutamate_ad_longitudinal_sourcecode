library(lavaan)
# Model A: Tau -> Glut -> Act -> Thick -> Decline
path_tau_first <- '
m_m_acc_z ~ plasma_ptau217_z
hipp_mean_act_z ~ m_m_acc_z
cortical_thickness_adsignature_dickson_z ~ hipp_mean_act_z
decliner_regression ~ cortical_thickness_adsignature_dickson_z + plasma_ptau217_z
'
# Model B: Glut -> Tau -> Act -> Thick -> Decline
path_glut_first <- '
plasma_ptau217_z ~ m_m_acc_z
hipp_mean_act_z ~ plasma_ptau217_z
cortical_thickness_adsignature_dickson_z ~ hipp_mean_act_z
decliner_regression ~ cortical_thickness_adsignature_dickson_z + m_m_acc_z
'
fit_A <- sem(path_tau_first, data = MRS_prediction)
fit_B <- sem(path_glut_first, data = MRS_prediction)
# Compare data-driven fit
AIC(fit_A, fit_B)
summary(fit_A, fit.measures = TRUE)
summary(fit_B, fit.measures = TRUE)
# Partially Mediated Network Model
path_network <- '
# Direct associations with decliner status
decliner_regression ~ c1*plasma_ptau217_z + c2*m_m_acc_z + c3*cortical_thickness_adsignature_dickson_z
# Structural injury relationships
cortical_thickness_adsignature_dickson_z ~ a1*plasma_ptau217_z + a2*m_m_acc_z
# Functional activation relationships
hipp_mean_act_z ~ b1*m_m_acc_z + b2*plasma_ptau217_z
# Allow residual covariance between metabolic and fluid markers
plasma_ptau217_z ~~ m_m_acc_z
'
fit_net <- sem(path_network, data = MRS_prediction)
summary(fit_net, fit.measures = TRUE, standardized = TRUE)
