library(readxl)
library(janitor)
library(jmv)
library(effectsize)
library(interactions)
library(emmeans)
library(lme4)
library(lmerTest)
library(pROC)
library(openxlsx)
library(survival)
# 1. Fit the age-adjusted Cox model for the Precuneus
cox_categorical_prec <- coxph(Surv(max_years_from_baseline, decliner_regression) ~ precuneus_tertiales + initiale_age, data = MRS_prediction)
# 2. Plot the age-adjusted curves for the Precuneus
ggadjustedcurves(cox_categorical_prec,
data = MRS_prediction,
variable = "precuneus_tertiales",
palette = c("#FDB863", "#999999", "#56B4E9"),
title = "Age-Adjusted Cognitive Stability by Precuneus Glutamate",
ylab = "Probability of Stability",
ggtheme = theme_minimal())
