model_data_tau <- subset(MRS_prediction_long, !is.na(moca) & !is.na(years_from_baseline) &
!is.na(plasma_ptau217_z) & !is.na(m_m_acc_z))
# MODEL BASE: p-tau217 + covariates + time interaction (No Cortical Thickness)
model_tau_base <- lmer(moca ~ years_from_baseline +
years_from_baseline:plasma_ptau217_z +
plasma_ptau217_z +
initiale_age + sexe + diagnostic_nick + education + (1 | pscid),
data = model_data_tau, REML = FALSE)
# MODEL PLUS GLU: Base Model + ACC Glutamate (main effect + time interaction)
model_tau_plus_glu <- lmer(moca ~ years_from_baseline +
years_from_baseline:plasma_ptau217_z +
years_from_baseline:m_m_acc_z +
plasma_ptau217_z + m_m_acc_z +
initiale_age + sexe + diagnostic_nick + education + (1 | pscid),
data = model_data_tau, REML = FALSE)
# 1. Compare Model Fit (AIC, BIC, Log-Likelihood)
model_comparison_tau <- data.frame(
Model = c("Base (p-tau217 only)", "Extended (p-tau217 + ACC Glu)"),
AIC = c(AIC(model_tau_base), AIC(model_tau_plus_glu)),
BIC = c(BIC(model_tau_base), BIC(model_tau_plus_glu)),
LogLik = c(logLik(model_tau_base), logLik(model_tau_plus_glu))
)
print(model_comparison_tau)
# 2. Formal Likelihood Ratio Test (ANOVA)
cat("\n--- LIKELIHOOD RATIO TEST (p-tau217 Base vs + ACC Glu) ---\n")
print(anova(model_tau_base, model_tau_plus_glu))
# 3. View Summary of Extended Model
cat("\n--- SUMMARY OF EXTENDED MODEL (+ ACC Glu) ---\n")
print(summary(model_tau_plus_glu))
