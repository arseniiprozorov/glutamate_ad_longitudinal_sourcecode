palette = palette_colors,
censor.size = 2.2,
censor.shape = 3,
pval = TRUE,
pval.coord = c(0.2, 0.15),
pval.size = 4,
conf.int = FALSE,
xlab = "Follow-up Duration (Years)",
ylab = "Cognitive Stability Probability",
title = title_text,
legend = c(0.70, 0.25),
legend.title = legend_title,
legend.labs = legend_labels,
ggtheme = theme_classic(base_size = 12, base_family = "Arial") +
theme(
plot.title        = element_text(face = "bold", size = 13),
axis.title        = element_text(face = "bold", size = 11),
axis.text         = element_text(color = "black", size = 10),
legend.title      = element_text(face = "bold", size = 9),
legend.text       = element_text(size = 8.5),
legend.background = element_rect(fill = alpha("white", 0.85), color = "grey85", linewidth = 0.5),
plot.margin       = margin(10, 10, 10, 10)
)
)
return(p$plot)
}
# ==============================================================================
# 3. Build Panels
# ==============================================================================
# Neurometabolic Palette (Low Glu = Red/At Risk, High Glu = Green/Protective)
mrs_colors <- c("#E64B35", "#4DBBD5", "#00A087")
# Risk Score Palette (Low Risk = Green, Intermediate = Blue, High Risk = Red)
risk_colors <- c("#00A087", "#4DBBD5", "#E64B35")
p_acc  <- plot_km_panel(fit_acc_km, MRS_prediction, "A. ACC Glutamate",
"Tertile", c("Low Glu", "Medium Glu", "High Glu"), mrs_colors)
p_prec <- plot_km_panel(fit_prec_km, MRS_prediction, "B. Precuneus Glutamate",
"Tertile", c("Low Glu", "Medium Glu", "High Glu"), mrs_colors)
p_mult <- plot_km_panel(fit_multi_km, MRS_prediction, "C. Multimodal Risk Profile",
"Risk Group", c("Low Risk", "Intermediate", "High Risk"), risk_colors)
