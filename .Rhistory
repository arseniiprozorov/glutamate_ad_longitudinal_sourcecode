# ==============================================================================
# 3. Model-Adjusted Median Survival Across Risk Strata (e.g., Low vs High ACC Glu)
# ==============================================================================
# Construct hypothetical participant profiles to test adjusted survival
# (Evaluating ACC Glu tertile effects holding p-tau217 & thickness at mean = 0)
new_cases_nocov <- data.frame(
plasma_ptau217_z = c(0, 0, 0),
m_m_acc_z = c(-1, 0, 1), # Low (-1 SD), Mean (0 SD), High (+1 SD)
cortical_thickness_adsignature_dickson_z = c(0, 0, 0),
Risk_Group = c("Low ACC Glu (-1 SD)", "Average ACC Glu (0 SD)", "High ACC Glu (+1 SD)")
)
# Fit adjusted survival curves for these clinical profiles
surv_pred_nocov <- survfit(cox_nocov, newdata = new_cases_nocov)
# Print median survival times across the 3 covariate-adjusted profiles
print(surv_pred_nocov)
# ==============================================================================
# Baseline Biomarker Correlation Matrix
# ==============================================================================
library(Hmisc)    # For rcorr (correlation coefficients + p-values)
library(corrplot) # For visualization
library(dplyr)
# 1. Select the core baseline biomarkers and continuous covariates
vars_for_corr <- c(
"plasma_ptau217_z",
"m_m_acc_z",
"m_m_precuneus_z",
"cortical_thickness_adsignature_dickson_z",
"hipp_mean_z",
"arsenii_hippocampus_avg_act",
"initiale_age",
"education_total_years" # or your specific education column name
)
# Subset dataset
df_corr <- MRS_prediction[, intersect(vars_for_corr, names(MRS_prediction))]
# Rename for clean publication display
colnames(df_corr) <- c(
"Plasma p-Tau217",
"ACC Glutamate",
"Precuneus Glutamate",
"Cortical Thickness",
"Hippocampal Volume",
"Hippocampal Activation",
"Age",
"Education"
)[1:ncol(df_corr)]
# 2. Compute Pearson Correlation Matrix with p-values (Pairwise Complete Cases)
corr_matrix <- rcorr(as.matrix(df_corr), type = "pearson")
r_values <- round(corr_matrix$r, 3)
p_values <- round(corr_matrix$P, 4)
n_obs    <- corr_matrix$n
# 3. Format Combined Matrix: "r (p-value)" for Reporting
formatted_matrix <- matrix("", nrow = nrow(r_values), ncol = ncol(r_values))
dimnames(formatted_matrix) <- dimnames(r_values)
for (i in 1:nrow(r_values)) {
for (j in 1:ncol(r_values)) {
if (i == j) {
formatted_matrix[i, j] <- "1.00"
} else if (i > j) {
p_str <- ifelse(p_values[i, j] < 0.001, "< .001", sprintf("%.3f", p_values[i, j]))
formatted_matrix[i, j] <- paste0(sprintf("%.2f", r_values[i, j]), " (p = ", p_str, ")")
} else {
formatted_matrix[i, j] <- "" # Keep upper triangle clean
}
}
}
# Print tabular matrix
as.data.frame(formatted_matrix)
# 4. Check Collinearity Assumption (Threshold: |r| >= 0.80)
high_corr <- which(abs(corr_matrix$r) >= 0.80 & abs(corr_matrix$r) < 1.0, arr.ind = TRUE)
if (nrow(high_corr) == 0) {
message("Collinearity Check PASSED: No pairwise biomarker correlations exceed |r| >= 0.80.")
} else {
message("Warning: Collinearity detected (|r| >= 0.80):")
print(high_corr)
}
# 5. Generate Publication Correlogram (Supplementary Figure)
corrplot(
corr_matrix$r,
method = "color",
type = "lower",
addCoef.col = "black",
tl.col = "black",
tl.srt = 45,
p.mat = corr_matrix$P,
sig.level = 0.05,
insig = "label_sig",
pch.cex = 0.9,
number.cex = 0.8,
diag = FALSE,
title = "Baseline Biomarker Correlation Matrix",
mar = c(0, 0, 2, 0)
)
