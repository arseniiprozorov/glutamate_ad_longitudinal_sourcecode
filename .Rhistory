## -----------------------------------------------------------------------------
mixed_model_thick_tert <- lmer(
moca ~ years_from_baseline * thick_tert + sexe + diagnostic_nick + education + (1 | pscid),
data = MRS_prediction_long
)
summary(mixed_model_thick_tert)
anova(mixed_model_thick_tert)
thick_tert_slopes <- emtrends(mixed_model_thick_tert, specs = ~ thick_tert, var = "years_from_baseline")
summary(thick_tert_slopes, infer = TRUE)
pairs(thick_tert_slopes)
