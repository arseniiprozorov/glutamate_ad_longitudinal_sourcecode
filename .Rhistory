## -----------------------------------------------------------------------------
## Optional: Independent Summaries for T1 vs T3 Subsets (if you need raw models)
## -----------------------------------------------------------------------------
# E.g., Precuneus - Tertile 1 (Lowest)
summary(lmer(
moca ~ years_from_baseline + sexe + diagnostic_nick + education + (1 | pscid),
data = subset(MRS_prediction_long, precuneus_tert == 1)
))
# E.g., Precuneus - Tertile 3 (Highest)
summary(lmer(
moca ~ years_from_baseline + sexe + diagnostic_nick + education + (1 | pscid),
data = subset(MRS_prediction_long, precuneus_tert == 3)
))
