library(lmerTest)
# Ensure complete cases for a fair, direct model comparison on the exact same subset
model_data <- subset(MRS_prediction_long, !is.na(moca) & !is.na(years_from_baseline) &
!is.na(plasma_ptau217_z) & !is.na(m_m_acc_z) &
!is.na(cortical_thickness_adsignature_dickson_z))
# MODEL A: Established Biomarkers Only (Age, Sex, Education, DX, Thickness, p-tau217 + time interactions)
model_A <- lmer(moca ~ years_from_baseline +
years_from_baseline:plasma_ptau217_z +
years_from_baseline:cortical_thickness_adsignature_dickson_z +
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z +
initiale_age + sexe + diagnostic_nick + education + (1 | pscid),
data = model_data, REML = FALSE)
# MODEL B: Model A + ACC Glutamate (Adding ACC Glu main effect and time interaction)
model_B <- lmer(moca ~ years_from_baseline +
years_from_baseline:plasma_ptau217_z +
years_from_baseline:cortical_thickness_adsignature_dickson_z +
years_from_baseline:m_m_acc_z +
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z + m_m_acc_z +
initiale_age + sexe + diagnostic_nick + education + (1 | pscid),
data = model_data, REML = FALSE)
# 1. Compare Model Fit (AIC, BIC, Log-Likelihood)
model_comparison <- data.frame(
Model = c("Model A (Established)", "Model B (Model A + ACC Glu)"),
AIC = c(AIC(model_A), AIC(model_B)),
BIC = c(BIC(model_A), BIC(model_B)),
LogLik = c(logLik(model_A), logLik(model_B))
)
print(model_comparison)
# 2. Formal Likelihood Ratio Test (ANOVA)
cat("\n--- LIKELIHOOD RATIO TEST (Model A vs Model B) ---\n")
print(anova(model_A, model_B))
# 3. View Summary of Model B to check ACC Glu contribution
cat("\n--- SUMMARY OF MODEL B ---\n")
print(summary(model_B))
