library(survival)
# Assuming your data has lower and upper bounds for when the decline interval occurred:
# time_lower: the last visit they were still stable
# time_upper: the first visit they crossed the decline threshold (or last visit if censored)
# status: 1 = interval-censored event, 0 = right-censored (never declined)
# Example model syntax using survival's interval-censoring engine:
interval_cox_acc <- ic_sp(Surv(time_lower, time_upper, status, type = "interval") ~ m_m_acc_z + initiale_age,
data = MRS_prediction)
library(pROC)
library(boot)
# Define a function to compute AUC on bootstrap resamples
boot_auc <- function(data, indices) {
d <- data[indices, ] # select bootstrap sample
fit <- glm(sustained_decliner ~ plasma_ptau217_z + m_m_acc_z + cortical_thickness_adsignature_dickson_z,
data = d, family = "binomial")
roc_obj <- roc(fit$y, fitted(fit), quiet = TRUE)
return(auc(roc_obj))
}
# Run 1,000 bootstrap iterations (handles missing data gracefully via complete cases)
set.seed(42)
complete_boot_data <- subset(MRS_prediction, !is.na(sustained_decliner) & !is.na(plasma_ptau217_z) & !is.na(m_m_acc_z) & !is.na(cortical_thickness_adsignature_dickson_z))
results <- boot(data = complete_boot_data, statistic = boot_auc, R = 1000)
# View the bootstrapped mean AUC and 95% Confidence Intervals
print(results)
boot.ci(results, type = "perc")
library(boot)
library(pROC)
# Helper function to bootstrap AUC for any glm formula and automatically handle missingness per model
run_boot_auc <- function(formula, data, R = 1000) {
vars <- all.vars(formula)
sub_data <- na.omit(data[, vars])
boot_func <- function(d, indices) {
d_sub <- d[indices, ]
fit <- glm(formula, data = d_sub, family = "binomial")
roc_obj <- roc(fit$y, fitted(fit), quiet = TRUE)
return(as.numeric(auc(roc_obj)))
}
set.seed(42)
b_res <- boot(data = sub_data, statistic = boot_func, R = R)
ci <- boot.ci(b_res, type = "perc")
# Handle case where boot.ci might fail or return NULL
ci_lower <- if(!is.null(ci$percent)) ci$percent[4] else NA
ci_upper <- if(!is.null(ci$percent)) ci$percent[5] else NA
list(
original_auc = b_res$t0,
se = sd(b_res$t),
ci_lower = ci_lower,
ci_upper = ci_upper
)
}
# Define all your models to test
formulas <- list(
"ACC Glutamate" = sustained_decliner ~ m_m_acc_z,
"Precuneus Glutamate" = sustained_decliner ~ m_m_precuneus_z,
"Plasma p-tau217" = sustained_decliner ~ plasma_ptau217_z,
"Cortical Thickness" = sustained_decliner ~ cortical_thickness_adsignature_dickson_z,
"Multimodal Model" = sustained_decliner ~ plasma_ptau217_z + m_m_acc_z + cortical_thickness_adsignature_dickson_z
)
# Run loop across all models
results_list <- lapply(names(formulas), function(name) {
cat("Running bootstrap for:", name, "...\n")
res <- run_boot_auc(formulas[[name]], data = MRS_prediction)
data.frame(
Model = name,
Original_AUC = round(res$original_auc, 3),
Std_Error = round(res$se, 3),
CI_95_Lower = round(res$ci_lower, 3),
CI_95_Upper = round(res$ci_upper, 3)
)
})
# Combine into a final publication-ready summary table
final_bootstrap_table <- do.call(rbind, results_list)
cat("\n========================================\n")
cat("BOOTSTRAPPED AUC SUMMARY TABLE (R = 1000)\n")
cat("========================================\n")
print(row.names = FALSE, final_bootstrap_table)
