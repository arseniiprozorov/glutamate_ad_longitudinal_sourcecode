par(mfrow = c(2, 3))
plot(gam_ptau217, se = TRUE, main = "Plasma p-tau217")
plot(gam_prec,    se = TRUE, main = "Precuneus Glu")
plot(gam_acc,     se = TRUE, main = "ACC Glu")
plot(gam_thick,   se = TRUE, main = "Cortical Thickness")
plot(gam_hip,     se = TRUE, main = "Hippocampal Activation")
library(car)
# 1. Check Multicollinearity
print("--- Variance Inflation Factors (VIF) ---")
vif(multimodal_glm)
#  ACC Glutamate + Plasma p-Tau217 + cortical thickenss
model_nocov_step_sig <- glm(decliner_regression ~ plasma_ptau217_z + m_m_acc_z + cortical_thickness_adsignature_dickson_z
, data = MRS_prediction, family = "binomial")
summary(model_nocov_step_sig)
roc_model_nocov_step_sig <- roc(model_nocov_step_sig$y, fitted(model_nocov_step_sig))
library(car)
# 1. Check Multicollinearity (VIF)
print("--- Variance Inflation Factors (VIF) ---")
vif(model_nocov_step_sig)
# 2. Check for Influential Outliers (Cook's Distance)
cooksd <- cooks.distance(model_nocov_step_sig)
threshold <- 4 / nobs(model_nocov_step_sig)
# Plot it visually
plot(model_nocov_step_sig, which = 4, main = "Cook's Distance: Multimodal GLM")
# List of all fitted Cox models
cox_models <- list(
ACC_age     = surv_acc,
Prec_age    = surv_prec,
pTau_age    = coxph(Surv(max_years_from_baseline, decliner_regression) ~ plasma_ptau217_z + initiale_age, data = MRS_prediction),
Thick_age   = coxph(Surv(max_years_from_baseline, decliner_regression) ~ cortical_thickness_adsignature_dickson_z + initiale_age, data = MRS_prediction),
HippAct_age = coxph(Surv(max_years_from_baseline, decliner_regression) ~ arsenii_hippocampus_avg_act + initiale_age, data = MRS_prediction),
Cox_NoCov   = cox_nocov,
Cox_Full    = cox_full
)
library(survival)
library(car)
# List of all fitted Cox models
cox_models <- list(
ACC_age     = surv_acc,
Prec_age    = surv_prec,
pTau_age    = coxph(Surv(max_years_from_baseline, decliner_regression) ~ plasma_ptau217_z + initiale_age, data = MRS_prediction),
Thick_age   = coxph(Surv(max_years_from_baseline, decliner_regression) ~ cortical_thickness_adsignature_dickson_z + initiale_age, data = MRS_prediction),
HippAct_age = coxph(Surv(max_years_from_baseline, decliner_regression) ~ arsenii_hippocampus_avg_act + initiale_age, data = MRS_prediction),
Cox_NoCov   = cox_nocov,
Cox_Full    = cox_full
)
# -------------------------------------------------------------
# 1. Proportional Hazards Assumption (Schoenfeld Residuals)
# -------------------------------------------------------------
cat("\n=== 1. PROPORTIONAL HAZARDS TESTS (cox.zph) ===\n")
zph_results <- lapply(cox_models, cox.zph)
lapply(zph_results, print)
# -------------------------------------------------------------
# 2. Multicollinearity (VIF) on Multivariable Models
# -------------------------------------------------------------
cat("\n=== 2. MULTICOLLINEARITY (VIF) ===\n")
cat("\n--- cox_nocov VIF ---\n")
print(vif(cox_nocov))
cat("\n--- cox_full VIF ---\n")
print(vif(cox_full))
# -------------------------------------------------------------
# 3. Influential Observations (dfbeta check on cox_nocov)
# -------------------------------------------------------------
cat("\n=== 3. INFLUENTIAL CASES (dfbetas on cox_nocov) ===\n")
dfb <- residuals(cox_nocov, type = "dfbeta")
# Check if any case changes a beta coefficient by more than 0.3 SD
influential_cox <- which(apply(abs(dfb), 1, max) > 0.3)
print(influential_cox)
