library(lmerTest)
# 1. Define the variables needed for the long model (adding moca, time, and pscid)
vars_long <- c("moca", "years_from_baseline", "m_m_acc_z", "m_m_precuneus_z",
"plasma_ptau217_z", "cortical_thickness_adsignature_dickson_z",
"arsenii_hippocampus_avg_act", "sexe", "diagnostic_nick",
"education", "initiale_age", "pscid")
# 2. Clean the LONG dataset
MRS_long_clean <- na.omit(MRS_prediction_long[, vars_long])
# 3. Run the massive model on the CLEAN LONG dataset
# (Note: I changed 'age' to 'initiale_age' to match your variables list)
massive_model <- lmer(moca ~ years_from_baseline * (m_m_acc_z + m_m_precuneus_z +
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z +
arsenii_hippocampus_avg_act) + initiale_age + sexe +
education + diagnostic_nick + (1 | pscid),
data = MRS_long_clean)
# 4. Run the stepwise selection
stepwise_mixed <- step(massive_model, reduce.fixed = TRUE, reduce.random = FALSE)
print(stepwise_mixed)
library(olsrr)
# 1. Complete cases extraction
vars <- c("slope_regression_yearly", "m_m_acc_z", "m_m_precuneus_z", "plasma_ptau217_z",
"cortical_thickness_adsignature_dickson_z", "arsenii_hippocampus_avg_act",
"sexe", "diagnostic_nick", "education", "initiale_age")
MRS_step_clean <- na.omit(MRS_prediction[, vars])
# 2. Full multivariable model & backward selection
full_model <- lm(slope_regression_yearly ~ m_m_acc_z + m_m_precuneus_z + plasma_ptau217_z +
cortical_thickness_adsignature_dickson_z + arsenii_hippocampus_avg_act +
sexe + diagnostic_nick + education + initiale_age,
data = MRS_step_clean)
step_result <- ols_step_backward_p(full_model, prem = 0.10, details = TRUE)
# 3. Output
print(step_result)
summary(step_result$model)
summary(lm(slope_regression_yearly ~ m_m_acc_z + plasma_ptau217_z +
cortical_thickness_adsignature_dickson_z, data = MRS_step_clean))
