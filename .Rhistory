library(olsrr)
# 1. Define all the variables needed for the combined model
vars_to_keep <- c("moca", "years_from_baseline",
"m_m_precuneus_z", "m_m_acc_z", "plasma_ptau217_z",
"cortical_thickness_adsignature_dickson_z", "arsenii_hippocampus_avg_act",
"age_difference", "sexe", "diagnostic_nick", "education", "initiale_age")
# 2. Subset the data and drop ANY row with missing values in these columns
# (Stepwise regression fails if the sample size changes mid-process)
MRS_clean <- MRS_prediction_long[, vars_to_keep]
MRS_clean <- MRS_clean[complete.cases(MRS_clean), ]
# 3. Build the FULL Ordinary Least Squares (OLS) model.
# By putting the biomarkers in parentheses and multiplying by years_from_baseline,
# R will automatically test both their main effects AND their interactions with time.
full_lm_formula <- as.formula(
moca ~ years_from_baseline * (m_m_precuneus_z +
m_m_acc_z +
plasma_ptau217_z +
cortical_thickness_adsignature_dickson_z +
arsenii_hippocampus_avg_act) +
age_difference + sexe + diagnostic_nick + education + initiale_age
)
# Fit the standard OLS model (temporarily ignoring the random effects)
OLS_full <- lm(full_lm_formula, data = MRS_clean)
# 4. Run the backward stepwise elimination (prem = 0.1 removes anything p > 0.10)
# Setting details = TRUE will print the step-by-step removal process to your console
backward_results <- ols_step_backward_p(OLS_full, prem = 0.1, details = TRUE)
# 5. View the final variables that survived the elimination
backward_results
# Optional: Plot a visualization of the step-by-step removal
plot(backward_results)
library(lme4)
library(lmerTest) # To get p-values in your summary
# Fit the final mixed-effects model
final_mixed_model <- lmer(
moca ~ years_from_baseline * m_m_acc_z +
years_from_baseline * arsenii_hippocampus_avg_act +
m_m_precuneus_z +
cortical_thickness_adsignature_dickson_z +
age_difference +
diagnostic_nick +
education +
initiale_age +
(1 | pscid),
data = MRS_prediction_long
)
# Review the results with valid repeated-measures p-values
summary(final_mixed_model)
library(lmerTest)
# 1. Create your clean dataset (stepwise functions still require no missing data)
vars_to_keep <- c("moca", "years_from_baseline",
"m_m_precuneus_z", "m_m_acc_z", "plasma_ptau217_z",
"cortical_thickness_adsignature_dickson_z", "arsenii_hippocampus_avg_act",
"age_difference", "sexe", "diagnostic_nick", "education", "initiale_age", "pscid")
MRS_clean <- MRS_prediction_long[, vars_to_keep]
MRS_clean <- MRS_clean[complete.cases(MRS_clean), ]
# 2. Fit the FULL mixed-effects model
# Note: Place your interacting variables in parentheses multiplied by years_from_baseline
full_mixed_model <- lmer(
moca ~ years_from_baseline * (m_m_precuneus_z +
m_m_acc_z +
plasma_ptau217_z +
cortical_thickness_adsignature_dickson_z +
arsenii_hippocampus_avg_act) +
age_difference + sexe + diagnostic_nick + education + initiale_age +
(1 | pscid),
data = MRS_clean
)
# 3. Run the backward stepwise elimination on the lmer model
# reduce.random = FALSE tells it to leave your (1 | pscid) alone and only eliminate fixed effects
step_result <- step(full_mixed_model, reduce.random = FALSE)
# 4. Print the elimination log to see exactly which variables were dropped and in what order
print(step_result)
# 5. Extract the final "winning" model into a new object
final_lmer_model <- get_model(step_result)
# 6. View the summary of your final model
summary(final_lmer_model)
