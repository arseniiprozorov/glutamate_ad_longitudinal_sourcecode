"T0 (Baseline)"  = sum(!is.na(MRS_prediction$initiale_moca_score_total_30)),
"T2 (2 years)"   = sum(!is.na(MRS_prediction$suivi_2_ans_moca_score_total_30)),
"T3 (4 years)"   = sum(!is.na(MRS_prediction$suivi_4_ans_moca_score_total_30)),
"T4 (6 years)"   = sum(!is.na(MRS_prediction$suivi_6_ans_moca_score_total_30)),
