# 1. Install and load the mediation package
# install.packages("mediation")
library(mediation)
# Ensure you are using baseline cross-sectional data (one row per participant)
# subsetting to your unique baseline participants
MRS_baseline <- MRS_clean_notau_old[!duplicated(MRS_clean_notau_old$pscid), ]
# -------------------------------------------------------------
# Test 1: Glutamate -> Hippocampal Activation -> Baseline MoCA
# -------------------------------------------------------------
# Step 1: Mediator Model (Path a: Predictor -> Mediator)
med_model_act <- lm(
arsenii_hippocampus_avg_act ~ m_m_acc_z + diagnostic_nick + education + initiale_age + sexe,
data = MRS_baseline
)
# Step 2: Outcome Model (Path b & c': Mediator + Predictor -> Outcome)
out_model_act <- lm(
moca ~ arsenii_hippocampus_avg_act + m_m_acc_z + diagnostic_nick + education + initiale_age + sexe,
data = MRS_baseline
)
# Step 3: Run Quasi-Bayesian Mediation (1,000 simulations)
results_med_act <- mediate(
model.m = med_model_act,
model.y = out_model_act,
treat = "m_m_acc_z",
mediator = "arsenii_hippocampus_avg_act",
boot = TRUE,
sims = 1000
)
# View summary (ACME = Average Causal Mediation Effect / Indirect Effect)
summary(results_med_act)
# -------------------------------------------------------------
# Test 2: Glutamate -> Cortical Thickness -> Baseline MoCA
# -------------------------------------------------------------
med_model_thick <- lm(
cortical_thickness_adsignature_dickson_z ~ m_m_acc_z + diagnostic_nick + education + initiale_age + sexe,
data = MRS_baseline
)
out_model_thick <- lm(
moca ~ cortical_thickness_adsignature_dickson_z + m_m_acc_z + diagnostic_nick + education + initiale_age + sexe,
data = MRS_baseline
)
results_med_thick <- mediate(
model.m = med_model_thick,
model.y = out_model_thick,
treat = "m_m_acc_z",
mediator = "cortical_thickness_adsignature_dickson_z",
boot = TRUE,
sims = 1000
)
summary(results_med_thick)
# 1. Define your 5 core multimodal predictors
core_predictors <- c(
"m_m_precuneus_z",
"m_m_acc_z",
"plasma_ptau217_z",
"cortical_thickness_adsignature_dickson_z",
"arsenii_hippocampus_avg_act"
)
# 2. Add the essential clinical covariates and outcome variables
# (Including 'decliner_regression' and 'time_to_event' for your next objectives)
essential_covariates <- c(
"pscid", "moca", "years_from_baseline",
"decliner_regression", "time_to_event",
"age_difference", "sexe", "diagnostic_nick", "education", "initiale_age"
)
# 3. Combine and clean the dataset
final_vars <- c(essential_covariates, core_predictors)
MRS_final_clean <- MRS_prediction_long[, final_vars]
MRS_final_clean <- MRS_final_clean[complete.cases(MRS_final_clean), ]
# Verify the final sample size
print(paste("Final N for all remaining analyses:", nrow(MRS_final_clean)))
# 1. Install required packages (if not already installed)
# install.packages("combinat")
# install.packages("dplyr")
library(combinat)
install.packages("combinat")
library(combinat)
library(lme4)
library(dplyr)
# 2. Define the 5 independent blocks (including their temporal interactions)
blocks <- list(
Tau = "years_from_baseline * plasma_ptau217_z",
Precuneus = "years_from_baseline * m_m_precuneus_z",
ACC = "years_from_baseline * m_m_acc_z",
Thickness = "years_from_baseline * cortical_thickness_adsignature_dickson_z",
Activation = "years_from_baseline * arsenii_hippocampus_avg_act"
)
# 3. Define the base clinical model
base_form <- "moca ~ years_from_baseline + sexe + diagnostic_nick + education + initiale_age + age_difference + (1 | pscid)"
# 4. Generate all 120 permutations of the 5 blocks
block_names <- names(blocks)
all_perms <- permn(block_names)
# 5. Loop through all 120 permutations
# (This will run 720 mixed models. It takes about 15-30 seconds to run)
cat("Running 120 permutations... Please wait.\n")
results_list <- list()
for (i in seq_along(all_perms)) {
order <- all_perms[[i]]
# Fit models iteratively
m0 <- lmer(as.formula(base_form), data = MRS_final_clean, REML = FALSE)
f1 <- paste(base_form, "+", blocks[[order[1]]])
m1 <- lmer(as.formula(f1), data = MRS_final_clean, REML = FALSE)
f2 <- paste(f1, "+", blocks[[order[2]]])
m2 <- lmer(as.formula(f2), data = MRS_final_clean, REML = FALSE)
f3 <- paste(f2, "+", blocks[[order[3]]])
m3 <- lmer(as.formula(f3), data = MRS_final_clean, REML = FALSE)
f4 <- paste(f3, "+", blocks[[order[4]]])
m4 <- lmer(as.formula(f4), data = MRS_final_clean, REML = FALSE)
f5 <- paste(f4, "+", blocks[[order[5]]])
m5 <- lmer(as.formula(f5), data = MRS_final_clean, REML = FALSE)
# Run ANOVA to test the addition of each block
a_res <- anova(m0, m1, m2, m3, m4, m5)
p_vals <- a_res$`Pr(>Chisq)`[-1] # Remove the NA for the base model
# Save the results
res <- data.frame(
Sequence = paste(order, collapse = " -> "),
Added_Variable = order,
Position_Added = 1:5,
P_Value = p_vals
)
results_list[[i]] <- res
}
# 6. Combine everything into one giant dataset
final_permutation_results <- do.call(rbind, results_list)
# 7. Create the Dominance Analysis Summary Table
summary_table <- final_permutation_results %>%
group_by(Added_Variable, Position_Added) %>%
summarise(
Times_Tested = n(),
Times_Significant = sum(P_Value < 0.05),
Percent_Significant = (Times_Significant / Times_Tested) * 100,
Avg_P_Value = round(mean(P_Value), 3),
.groups = "drop"
) %>%
arrange(Added_Variable, Position_Added)
# Print the final pattern table!
print(as.data.frame(summary_table))
