library(dplyr)
# =====================================================================
# STEP 1: CREATE THE TERTILES IN THE WIDE DATASET
# =====================================================================
acc_terials <- quantile(MRS_prediction$m_m_acc_z, probs = c(0, 1/3, 2/3, 1), na.rm = TRUE)
precuneus_terials <- quantile(MRS_prediction$m_m_precuneus_z, probs = c(0, 1/3, 2/3, 1), na.rm = TRUE)
MRS_prediction$acc_tertiales <- cut(MRS_prediction$m_m_acc_z,
breaks = acc_terials,
labels = c("Low ACC Glu", "Medium ACC Glu", "High ACC Glu"),
include.lowest = TRUE)
MRS_prediction$precuneus_tertiales <- cut(MRS_prediction$m_m_precuneus_z,
breaks = precuneus_terials,
labels = c("Low Precuneus Glu", "Medium Precuneus Glu", "High Precuneus Glu"),
include.lowest = TRUE)
# =====================================================================
# STEP 2: LONG -> WIDE (Move Max Years to the Wide Dataset)
# =====================================================================
max_followup_df <- MRS_prediction_long %>%
group_by(pscid) %>%
summarise(max_years_from_baseline = max(years_from_baseline, na.rm = TRUE)) %>%
ungroup()
# Create the final updated wide dataset
MRS_prediction_updated <- left_join(MRS_prediction, max_followup_df, by = "pscid")
# =====================================================================
# STEP 3: WIDE -> LONG (Move Tertiles to the Long Dataset)
# =====================================================================
# Extract just the ID and the two new tertile columns
tertiles_to_move <- MRS_prediction_updated %>%
select(pscid, acc_tertiales, precuneus_tertiales)
# Create the final updated long dataset
MRS_prediction_long_updated <- left_join(MRS_prediction_long, tertiles_to_move, by = "pscid")
# =====================================================================
# STEP 4: SAVE BOTH UPDATED DATASETS
# =====================================================================
write.csv(MRS_prediction_updated, "MRS_prediction_final_wide.csv", row.names = FALSE)
write.csv(MRS_prediction_long_updated, "MRS_prediction_final_long.csv", row.names = FALSE)
