library(survival)
# 1. Isolate the exact variables requested by the reviewer
# This ensures N is identical for both models (complete cases only)
vars_needed <- c("time_to_sustained_decline", "sustained_decliner",
"initiale_age", "sexe",
"plasma_ptau217_z", "cortical_thickness_adsignature_dickson_z",
"m_m_acc_z")
df_boot <- na.omit(MRS_prediction[, vars_needed])
# 2. Set up the Bootstrap parameters
set.seed(2026)
B <- 1000      # 1000 iterations for robust CI estimation
c_model_a <- numeric(B)
c_model_b <- numeric(B)
delta_c <- numeric(B)
# 3. Run the Bootstrap Loop
cat("Running", B, "bootstrap iterations for Delta C-index... Please wait.\n")
for(i in 1:B) {
# Sample with replacement
idx <- sample(1:nrow(df_boot), replace = TRUE)
boot_sample <- df_boot[idx, ]
# MODEL A: Established Biomarkers (Age + Sex + Cortical Thickness + pTau217)
fit_a <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
initiale_age + sexe + plasma_ptau217_z + cortical_thickness_adsignature_dickson_z,
data = boot_sample)
# MODEL B: Established + ACC Glutamate
fit_b <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
initiale_age + sexe + plasma_ptau217_z + cortical_thickness_adsignature_dickson_z + m_m_acc_z,
data = boot_sample)
# Calculate Concordance (C-index)
c_model_a[i] <- concordance(fit_a)$concordance
c_model_b[i] <- concordance(fit_b)$concordance
# Calculate the difference (Delta C)
delta_c[i] <- c_model_b[i] - c_model_a[i]
}
# 4. Output the Results
cat("\n--- Bootstrap Validation: Model A vs Model B (1000 iterations) ---\n")
cat("Median Model A C-index:", round(median(c_model_a), 3), "\n")
cat("Median Model B C-index:", round(median(c_model_b), 3), "\n")
cat("Median Delta C-index:", round(median(delta_c), 3), "\n")
cat("95% CI for Delta C-index:",
round(quantile(delta_c, probs = 0.025), 3), "to",
round(quantile(delta_c, probs = 0.975), 3), "\n")
############### Habib theory driven ###########
names(MRS_prediction_long)
MRS_core_long <- na.omit(MRS_prediction_long[, c("pscid", "moca", "years_from_baseline", "m_m_acc_z",
"m_m_precuneus_z", "plasma_ptau217_z",
"cortical_thickness_adsignature_dickson_z",
"arsenii_hippocampus_avg_act", "sexe",
"diagnostic_nick", "education", "initiale_age", "age_difference")])
# Step 1: null model
base_model <- lmer(
moca ~ years_from_baseline * (plasma_ptau217_z + cortical_thickness_adsignature_dickson_z) +
age_difference + sexe + diagnostic_nick + education + initiale_age +
(1 | pscid),data = MRS_core_long, REML = FALSE)
summary(base_model)
library(survival)
# Harmonize sample across all evaluated candidates (N = 48 complete multimodal cases)
vars_nested <- c("time_to_sustained_decline", "sustained_decliner",
"plasma_ptau217_z", "cortical_thickness_adsignature_dickson_z",
"m_m_acc_z", "m_m_precuneus_z", "arsenii_hippocampus_avg_act")
df_nest <- na.omit(MRS_prediction[, vars_nested])
set.seed(2026)
B <- 1000
c_null     <- numeric(B)
c_acc      <- numeric(B)
c_prec     <- numeric(B)
c_act      <- numeric(B)
c_full     <- numeric(B)
d_acc_null <- numeric(B)
d_full_null<- numeric(B)
for (i in 1:B) {
# Stratified resample to maintain event/censor ratio
evt_idx  <- sample(which(df_nest$sustained_decliner == 1), replace = TRUE)
none_idx <- sample(which(df_nest$sustained_decliner == 0), replace = TRUE)
boot_df  <- df_nest[c(evt_idx, none_idx), ]
# Fit candidate sequence
m_null <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z,
data = boot_df)
m_acc  <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z + m_m_acc_z,
data = boot_df)
m_prec <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z + m_m_precuneus_z,
data = boot_df)
m_act  <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z + arsenii_hippocampus_avg_act,
data = boot_df)
m_full <- coxph(Surv(time_to_sustained_decline, sustained_decliner) ~
plasma_ptau217_z + cortical_thickness_adsignature_dickson_z +
m_m_acc_z + m_m_precuneus_z + arsenii_hippocampus_avg_act,
data = boot_df)
c_null[i] <- concordance(m_null)$concordance
c_acc[i]  <- concordance(m_acc)$concordance
c_prec[i] <- concordance(m_prec)$concordance
c_act[i]  <- concordance(m_act)$concordance
c_full[i] <- concordance(m_full)$concordance
d_acc_null[i]  <- c_acc[i]  - c_null[i]
d_full_null[i] <- c_full[i] - c_null[i]
}
# Reporting Summary
res <- data.frame(
Model = c("Null (Core: p-tau217 + Thickness)",
"Core + ACC Glutamate",
"Core + Precuneus Glutamate",
"Core + Hippocampal Activation",
"Full Multimodal Model"),
Median_C = c(median(c_null), median(c_acc), median(c_prec), median(c_act), median(c_full)),
LCL_95   = c(quantile(c_null, 0.025), quantile(c_acc, 0.025), quantile(c_prec, 0.025),
quantile(c_act, 0.025), quantile(c_full, 0.025)),
UCL_95   = c(quantile(c_null, 0.975), quantile(c_acc, 0.975), quantile(c_prec, 0.975),
quantile(c_act, 0.975), quantile(c_full, 0.975))
)
print(round(res[, 2:4], 3))
cat("\n--- Incremental Discrimination Gain (Delta C) ---\n")
cat("Median Delta C (Core + ACC vs Null):", round(median(d_acc_null), 3),
"| 95% CI: [", round(quantile(d_acc_null, 0.025), 3), ",",
round(quantile(d_acc_null, 0.975), 3), "]\n")
cat("Median Delta C (Full vs Null):", round(median(d_full_null), 3),
"| 95% CI: [", round(quantile(d_full_null, 0.025), 3), ",",
round(quantile(d_full_null, 0.975), 3), "]\n")
surv_acc <- coxph(Surv(time_to_sustained_decline , sustained_decliner) ~ m_m_acc_z  + initiale_age, data = MRS_prediction)
