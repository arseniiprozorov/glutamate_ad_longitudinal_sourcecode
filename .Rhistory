library(pROC)
library(openxlsx)
library(survival)
options(na.action = "na.omit")
names(MRS_prediction)
# Mean years prior to baseline for the T-1 subsample
mean(abs(tau_diff[!is.na(MRS_prediction$plasma_ptau217) & tau_diff < -0.25]))
# ==============================================================================
# Plasma p-tau217 Timing Relative to Baseline (initiale_age)
# ==============================================================================
# 1. Calculate time difference in years (age at blood draw minus baseline age)
tau_diff <- MRS_prediction$age_tau - MRS_prediction$initiale_age
# 2. Define timing categories and calculate counts:
# - T-1: blood draw before baseline (< -0.25 years / > 3 months prior)
# - T0: concurrent with baseline (within +/- 3 months)
# - After: blood draw after baseline (> +0.25 years)
ptau_breakdown <- table(
Timing = ifelse(
is.na(MRS_prediction$plasma_ptau217), "Missing p-tau",
ifelse(tau_diff < -0.25, "T-1 (Prior / >3 mo before)",
ifelse(tau_diff > 0.25, "After Baseline (>3 mo after)",
"T0 (Concurrent Baseline)"))
),
useNA = "ifany"
)
# 3. Print the number of participants at each timepoint
cat("--- Exact Breakdown of Plasma p-tau217 Timing ---\n")
print(ptau_breakdown)
# 4. Check the distribution/summary of the age difference for available p-tau
cat("\n--- Summary of Gap (age_tau - initiale_age) in Years ---\n")
print(summary(tau_diff[!is.na(MRS_prediction$plasma_ptau217)]))
# 5. Calculate the specific mean gap for the T-1 (Prior) subsample
mean_prior_gap <- mean(abs(tau_diff[!is.na(MRS_prediction$plasma_ptau217) & tau_diff < -0.25]))
cat("\n--- Mean years prior to baseline for the T-1 subsample ---\n")
print(mean_prior_gap)
# ==============================================================================
# Granular Breakdown of the T-1 Subsample (N = 41)
# ==============================================================================
# Subset the prior gap values in positive years
prior_gaps <- abs(tau_diff[!is.na(MRS_prediction$plasma_ptau217) & tau_diff < -0.25])
# Bin into 2-year clinical intervals
interval_breakdown <- table(
Interval = cut(
prior_gaps,
breaks = c(0.25, 2, 4, 6, 8, Inf),
labels = c("0.25 to 2 yrs prior (~2y)",
">2 to 4 yrs prior (~4y)",
">4 to 6 yrs prior (~6y)",
">6 to 8 yrs prior (~8y)",
">8 yrs prior"),
right = TRUE
)
)
cat("--- 2-Year Interval Breakdown (N = 41) ---\n")
print(interval_breakdown)
print(round(prop.table(interval_breakdown) * 100, 1))
# Exact integer year table (rounded to nearest year)
cat("\n--- Rounded to Nearest Year Prior ---\n")
print(table(Years_Prior = round(prior_gaps)))
