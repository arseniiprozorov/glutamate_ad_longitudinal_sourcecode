library(pROC)
# ==============================================================================
# Helper Function for In-Sample (Apparent) Performance
# ==============================================================================
get_insample_metrics <- function(model, model_name) {
# Generate in-sample ROC curve
roc_obj <- roc(model$y, fitted(model), quiet = TRUE)
# Optimal threshold coordinates via Youden Index
coords_obj <- coords(roc_obj, "best", ret = c("threshold", "specificity", "sensitivity"), best.method = "youden")
if (!is.null(nrow(coords_obj)) && nrow(coords_obj) > 1) coords_obj <- coords_obj[1, ]
# Apparent classification accuracy at optimal threshold
pred_class <- ifelse(fitted(model) >= coords_obj$threshold, 1, 0)
acc <- mean(pred_class == model$y)
# Model Likelihood Ratio Chi-Square test
chsq <- model$null.deviance - model$deviance
df <- model$df.null - model$df.residual
pval <- pchisq(chsq, df, lower.tail = FALSE)
data.frame(
Model          = model_name,
N_Obs          = length(model$y),
InSample_AUC   = round(auc(roc_obj) * 100, 1),
Accuracy       = round(acc * 100, 1),
Sensitivity    = round(coords_obj$sensitivity * 100, 1),
Specificity    = round(coords_obj$specificity * 100, 1),
LR_ChiSq       = round(chsq, 2),
p_value        = signif(pval, 3)
)
}
# ==============================================================================
# 1. In-Sample Metrics: Model A (p-Tau217 + ACC Glu + Age + Sex)
# ==============================================================================
model_ptau217_acc_cov <- glm(
decliner_regression ~ plasma_ptau217_z + m_m_acc_z + sexe + initiale_age,
data = MRS_prediction,
family = "binomial"
)
summary(model_ptau217_acc_cov)
exp(cbind(OR = coef(model_ptau217_acc_cov), confint(model_ptau217_acc_cov)))
res_model_a <- get_insample_metrics(model_ptau217_acc_cov, "p-Tau217 + ACC Glu + Age + Sex")
print(res_model_a)
